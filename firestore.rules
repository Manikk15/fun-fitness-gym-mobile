rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isActiveAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function userGymId(data) {
      return 'gymId' in data ? data.gymId : 'fun-fitness-gym';
    }
    function currentGymId() {
      return userGymId(
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data
      );
    }
    function isGymAdmin(gymId) {
      return isActiveAdmin() && currentGymId() == gymId;
    }
    function isActiveGymTrainer(gymId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && currentGymId() == gymId;
    }
    function isActiveSelfMember(memberId) {
      return signedIn()
        && request.auth.uid == memberId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'member'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function targetIsActiveMember(memberId, gymId) {
      return get(/databases/$(database)/documents/users/$(memberId)).data.role == 'member'
        && get(/databases/$(database)/documents/users/$(memberId)).data.status == 'active'
        && ('gymId' in get(/databases/$(database)/documents/users/$(memberId)).data
          ? get(/databases/$(database)/documents/users/$(memberId)).data.gymId
          : 'fun-fitness-gym') == gymId;
    }
    function canReadMasterData(gymId, isActive) {
      return isGymAdmin(gymId) || (isActiveGymTrainer(gymId) && isActive == true);
    }
    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (request.auth.uid == userId || isActiveAdmin());
      allow update: if (signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'updatedAt']))
        || (isActiveAdmin() && request.auth.uid != userId
          && resource.data.role == 'member'
          && request.resource.data.role == 'member'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt', 'updatedAt'])
          && request.resource.data.approvedBy == request.auth.uid)
        || (isGymAdmin(userGymId(resource.data))
          && resource.data.role == 'member'
          && request.resource.data.role == resource.data.role
          && userGymId(request.resource.data) == userGymId(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'phone', 'age', 'gender', 'heightCm', 'currentWeightKg',
            'goal', 'joiningDate', 'emergencyContactName', 'emergencyContactPhone',
            'address', 'notes', 'updatedAt'
          ]));
      allow delete: if false;
    }

    match /exerciseCategories/{categoryId} {
      allow read: if canReadMasterData(resource.data.gymId, resource.data.isActive);
      allow create: if isGymAdmin(request.resource.data.gymId)
        && request.resource.data.id == categoryId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.isActive == true;
      allow update: if isGymAdmin(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /exerciseLibrary/{exerciseId} {
      allow read: if canReadMasterData(resource.data.gymId, resource.data.isActive);
      allow create: if isGymAdmin(request.resource.data.gymId)
        && request.resource.data.id == exerciseId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.isActive == true
        && get(/databases/$(database)/documents/exerciseCategories/$(request.resource.data.categoryId)).data.gymId == request.resource.data.gymId;
      allow update: if isGymAdmin(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && get(/databases/$(database)/documents/exerciseCategories/$(request.resource.data.categoryId)).data.gymId == resource.data.gymId;
      allow delete: if false;
    }

    match /workoutMasters/{masterId} {
      allow read: if canReadMasterData(resource.data.gymId, resource.data.isActive);
      allow create: if isGymAdmin(request.resource.data.gymId)
        && request.resource.data.id == masterId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.isActive == true
        && request.resource.data.workoutType in ['compound', 'dual', 'single', 'cardio', 'custom'];
      allow update: if isGymAdmin(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.workoutType in ['compound', 'dual', 'single', 'cardio', 'custom'];
      allow delete: if false;
    }

    match /memberWorkouts/{workoutId} {
      allow read: if isGymAdmin(resource.data.gymId)
        || isActiveSelfMember(resource.data.memberId);
      allow create: if isGymAdmin(request.resource.data.gymId)
        && targetIsActiveMember(request.resource.data.memberId, request.resource.data.gymId)
        && request.resource.data.id == workoutId
        && request.resource.data.assignedBy == request.auth.uid
        && request.resource.data.status == 'assigned'
        && request.resource.data.exerciseCount > 0;
      allow update: if (isGymAdmin(resource.data.gymId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['assigned', 'cancelled'])
        || (isActiveSelfMember(resource.data.memberId)
          && resource.data.status == 'assigned'
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'completedAt', 'completedExerciseCount', 'updatedAt'])
          && request.resource.data.completedExerciseCount >= 0
          && request.resource.data.completedExerciseCount <= resource.data.exerciseCount);
      allow delete: if false;
    }

    match /memberWorkoutExercises/{exerciseId} {
      allow read: if isGymAdmin(resource.data.gymId)
        || isActiveSelfMember(resource.data.memberId);
      allow create: if isGymAdmin(request.resource.data.gymId)
        && request.resource.data.id == exerciseId
        && request.resource.data.order > 0
        && getAfter(/databases/$(database)/documents/memberWorkouts/$(request.resource.data.memberWorkoutId)).data.gymId == request.resource.data.gymId
        && getAfter(/databases/$(database)/documents/memberWorkouts/$(request.resource.data.memberWorkoutId)).data.memberId == request.resource.data.memberId
        && getAfter(/databases/$(database)/documents/memberWorkouts/$(request.resource.data.memberWorkoutId)).data.assignedBy == request.auth.uid;
      allow update: if isActiveSelfMember(resource.data.memberId)
        && get(/databases/$(database)/documents/memberWorkouts/$(resource.data.memberWorkoutId)).data.memberId == request.auth.uid
        && get(/databases/$(database)/documents/memberWorkouts/$(resource.data.memberWorkoutId)).data.status == 'assigned'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isCompleted', 'completedAt', 'updatedAt'])
        && request.resource.data.isCompleted is bool;
      allow delete: if false;
    }

    match /memberMeasurements/{measurementId} {
      allow read: if isGymAdmin(resource.data.gymId)
        || isActiveSelfMember(resource.data.memberId);
      allow create: if isGymAdmin(request.resource.data.gymId)
        && targetIsActiveMember(request.resource.data.memberId, request.resource.data.gymId)
        && request.resource.data.id == measurementId
        && request.resource.data.recordedBy == request.auth.uid;
      allow update: if isGymAdmin(resource.data.gymId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.gymId == resource.data.gymId
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.recordedBy == resource.data.recordedBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isGymAdmin(resource.data.gymId);
    }

  }
}
