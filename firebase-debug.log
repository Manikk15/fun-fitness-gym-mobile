[debug] [2026-08-04T13:41:59.719Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/fun-fitness-gym/rulesets {"name":"projects/fun-fitness-gym/rulesets/c642ff32-bbb2-48e8-86e3-9fef07a9578a","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function isActiveAdmin() {\n      return signedIn()\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';\n    }\n    function isPublishedActivePlan(planId) {\n      return get(/databases/$(database)/documents/trainingPlans/$(planId)).data.status == 'published'\n        && get(/databases/$(database)/documents/trainingPlans/$(planId)).data.active == true;\n    }\n\n    match /users/{userId} {\n      allow create: if signedIn() && request.auth.uid == userId\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.role == 'member'\n        && request.resource.data.status == 'pending'\n        && request.resource.data.currentTrainingPlanType == null;\n      allow read: if signedIn() && (request.auth.uid == userId || isActiveAdmin());\n      allow update: if (signedIn() && request.auth.uid == userId\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'updatedAt']))\n        || (isActiveAdmin() && request.auth.uid != userId\n          && resource.data.role == 'member'\n          && request.resource.data.role == 'member'\n          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt', 'updatedAt'])\n            && request.resource.data.approvedBy == request.auth.uid)\n            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentTrainingPlanType', 'updatedAt'])\n            || (resource.data.status == 'active'\n              && request.resource.data.status == 'active'\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                'assignedTrainingPlanId',\n                'assignedTrainingPlanNameSnapshot',\n                'assignedTrainingPlanType',\n                'assignedAt',\n                'assignedBy',\n                'updatedAt'\n              ])\n              && ((request.resource.data.assignedTrainingPlanId == null\n                && request.resource.data.assignedTrainingPlanNameSnapshot == null\n                && request.resource.data.assignedTrainingPlanType == null\n                && request.resource.data.assignedAt == null\n                && request.resource.data.assignedBy == null)\n                || (request.resource.data.assignedTrainingPlanId != null\n                  && isPublishedActivePlan(request.resource.data.assignedTrainingPlanId)\n                  && request.resource.data.assignedTrainingPlanNameSnapshot\n                    == get(/databases/$(database)/documents/trainingPlans/$(request.resource.data.assignedTrainingPlanId)).data.name\n                  && request.resource.data.assignedTrainingPlanType\n                    == get(/databases/$(database)/documents/trainingPlans/$(request.resource.data.assignedTrainingPlanId)).data.trainingPlanType\n                  && request.resource.data.assignedAt == request.time\n                  && request.resource.data.assignedBy == request.auth.uid)))));\n      allow delete: if false;\n    }\n\n    match /memberTrainingAssignments/{assignmentId} {\n      allow read: if isActiveAdmin()\n        || (signedIn() && resource.data.memberId == request.auth.uid);\n      allow create: if isActiveAdmin()\n        && request.resource.data.memberId != request.auth.uid\n        && request.resource.data.assignedBy == request.auth.uid\n        && request.resource.data.timestamp == request.time\n        && get(/databases/$(database)/documents/users/$(request.resource.data.memberId)).data.role == 'member'\n        && get(/databases/$(database)/documents/users/$(request.resource.data.memberId)).data.status == 'active'\n        && request.resource.data.newPlanId\n          == getAfter(/databases/$(database)/documents/users/$(request.resource.data.memberId)).data.assignedTrainingPlanId\n        && (request.resource.data.newPlanId == null\n          || isPublishedActivePlan(request.resource.data.newPlanId));\n      allow update, delete: if false;\n    }\n\n    match /categories/{categoryId} {\n      allow read, create, update: if isActiveAdmin();\n      allow delete: if false;\n    }\n\n    match /exercises/{exerciseId} {\n      allow read, create, update: if isActiveAdmin();\n      allow delete: if false;\n    }\n\n    match /trainingPlanTemplates/{templateId} {\n      allow read, create, update: if isActiveAdmin();\n      allow delete: if false;\n    }\n\n    match /trainingPlans/{planId} {\n      allow read: if isActiveAdmin();\n      allow create: if isActiveAdmin()\n        && request.resource.data.createdBy == request.auth.uid\n        && request.resource.data.trainingPlanType in ['compound_full_body', 'two_muscle_split', 'single_muscle_split']\n        && request.resource.data.status in ['draft', 'published', 'archived'];\n      allow update: if isActiveAdmin()\n        && request.resource.data.createdBy == resource.data.createdBy\n        && request.resource.data.trainingPlanType in ['compound_full_body', 'two_muscle_split', 'single_muscle_split']\n        && request.resource.data.status in ['draft', 'published', 'archived'];\n      allow delete: if false;\n\n      match /workoutDays/{dayId} {\n        allow read: if isActiveAdmin();\n        allow create, update: if isActiveAdmin()\n          && get(/databases/$(database)/documents/trainingPlans/$(planId)).data.active == true\n          && get(/databases/$(database)/documents/trainingPlans/$(planId)).data.status != 'archived'\n          && request.resource.data.order >= 1;\n        allow delete: if false;\n\n        match /exercises/{itemId} {\n          allow read: if isActiveAdmin();\n          allow create, update: if isActiveAdmin()\n            && get(/databases/$(database)/documents/trainingPlans/$(planId)).data.active == true\n            && get(/databases/$(database)/documents/trainingPlans/$(planId)).data.status != 'archived'\n            && request.resource.data.sets >= 1\n            && request.resource.data.sets <= 20\n            && request.resource.data.reps >= 1\n            && request.resource.data.reps <= 100\n            && request.resource.data.displayOrder >= 1\n            && (request.resource.data.targetWeight == null || request.resource.data.targetWeight >= 0)\n            && (request.resource.data.restSeconds == null\n              || (request.resource.data.restSeconds >= 0 && request.resource.data.restSeconds <= 600));\n          allow delete: if false;\n        }\n      }\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-04T13:41:59.524863Z","metadata":{"services":["cloud.firestore"]}}
